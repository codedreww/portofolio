---
import { getCollection, render } from 'astro:content';
import Split from '../../layouts/Split.astro';

// Runs at build time and lists every project page the site should have.
export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Split title={entry.data.title} heading={entry.data.title} caption={`${entry.id}.md`} scene={entry.data.scene}>
  <a class="back" href={`${base}/#projects`} data-back>Back to all projects <kbd>esc</kbd></a>
  <p class="tags">{[entry.data.year, ...entry.data.tags].map((tag) => <span>{tag}</span>)}</p>
  <p class="lede">{entry.data.blurb}</p>
  <article class="md"><Content /></article>
  {next.id !== entry.id && (
    <a class="next" href={`${base}/projects/${next.id}/`}>
      <span>Next project</span>
      <b>{next.data.title}</b>
      <em>{next.data.blurb}</em>
    </a>
  )}
</Split>
