---
import { getCollection, getEntry, render } from 'astro:content';
import Split from '../layouts/Split.astro';

// Works whether the site lives at the root of a domain or in a sub-folder.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const about = await getEntry('pages', 'about');
const contact = await getEntry('pages', 'contact');
if (!about || !contact) throw new Error('src/content/pages needs both about.md and contact.md');
const { Content: About } = await render(about);
const { Content: Contact } = await render(contact);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<Split title="Andrew Tan" heading="Andrew Tan" caption="software developer" scene="hills">
  <article class="md intro"><About /></article>

  <h2 id="projects">Projects</h2>
  <ul class="rows">
    {projects.map((project) => (
      <li>
        <a class="row" href={`${base}/projects/${project.id}/`}>
          <span class="t">{project.data.title}</span>
          <span class="b">{project.data.blurb}</span>
          <span class="y">{project.data.year}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2 id="experience">Experience</h2>
  <ul class="rows roles">
    {experience.map((job) => {
      // A job with a write-up becomes a link. One without stays plain text.
      const hasPage = Boolean(job.body?.trim());
      const Row = hasPage ? 'a' : 'div';
      return (
        <li>
          <Row class="row" href={hasPage ? `${base}/experience/${job.id}/` : undefined}>
            <span class="t">{job.data.role}</span>
            <span class="b">{job.data.place}</span>
            <span class="y">{job.data.years}</span>
          </Row>
        </li>
      );
    })}
  </ul>

  <h2 id="contact">Contact</h2>
  <article class="md"><Contact /></article>
</Split>
